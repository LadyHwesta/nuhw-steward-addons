<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="module_category_nuhw" model="ir.module.category">
        <field name="name">NUHW Steward Suite</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_nuhw" model="res.groups.privilege">
        <field name="name">NUHW Steward Suite</field>
        <field name="category_id" ref="module_category_nuhw" />
        <field name="sequence">10</field>
    </record>

    <record id="group_nuhw_steward" model="res.groups">
        <field name="name">Steward</field>
        <field name="privilege_id" ref="privilege_nuhw" />
        <field name="comment">Full access to Weingarten meetings, grievances,
            direct actions, and hardship fund requests. Never grant this to
            a portal or public user - this data can include disciplinary
            and medical-leave details.</field>
    </record>

</odoo>
