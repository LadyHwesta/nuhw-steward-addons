<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nuhw_unit_view_list" model="ir.ui.view">
        <field name="name">nuhw.unit.list</field>
        <field name="model">nuhw.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="member_count" />
            </list>
        </field>
    </record>

    <record id="nuhw_unit_view_form" model="ir.ui.view">
        <field name="name">nuhw.unit.form</field>
        <field name="model">nuhw.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                    </group>
                    <field name="description" />
                    <notebook>
                        <page string="Members">
                            <field name="member_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="job_classification" />
                                    <field name="shift" />
                                    <field name="is_steward" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nuhw_unit_action" model="ir.actions.act_window">
        <field name="name">Bargaining Units</field>
        <field name="res_model">nuhw.unit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
