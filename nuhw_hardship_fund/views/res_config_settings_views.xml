<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_nuhw_hardship" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nuhw.hardship</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Hardship Fund"
                     string="Hardship Fund" data-key="nuhw_hardship_fund"
                     groups="base.group_system">
                    <h2>Hardship Fund Disbursement Accounts</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="nuhw_hardship_disbursement_account_id" />
                                <div class="text-muted">
                                    Expense account debited when a hardship
                                    request is marked paid.
                                </div>
                                <field name="nuhw_hardship_disbursement_account_id" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="nuhw_hardship_payable_account_id" />
                                <div class="text-muted">
                                    Payable or cash/bank account credited on
                                    the same disbursement entry.
                                </div>
                                <field name="nuhw_hardship_payable_account_id" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
