<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nuhw_hardship_request_view_form" model="ir.ui.view">
        <field name="name">nuhw.hardship_request.form</field>
        <field name="model">nuhw.hardship_request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state not in ('submitted', 'under_review')" />
                    <button name="action_deny" type="object"
                            string="Deny"
                            invisible="state not in ('submitted', 'under_review')" />
                    <button name="action_mark_paid" type="object"
                            string="Mark Paid" class="btn-primary"
                            invisible="state != 'approved'" />
                    <field name="state" widget="statusbar"
                           statusbar_visible="submitted,under_review,approved,paid" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button">
                            <field name="fund_balance" widget="statinfo"
                                   string="Current Fund Balance" />
                        </div>
                    </div>
                    <div class="oe_title">
                        <h1><field name="partner_id" placeholder="Member" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_requested" />
                            <field name="amount_requested" />
                            <field name="amount_approved" />
                        </group>
                        <group>
                            <field name="reviewer_ids" widget="many2many_tags" />
                            <field name="disbursement_move_id" readonly="1" />
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason for the request..." />
                    <field name="denial_reason"
                           invisible="state != 'denied'"
                           placeholder="Reason for denial..." />
                    <field name="notes" placeholder="Notes..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="nuhw_hardship_request_view_list" model="ir.ui.view">
        <field name="name">nuhw.hardship_request.list</field>
        <field name="model">nuhw.hardship_request</field>
        <field name="arch" type="xml">
            <list>
                <field name="date_requested" />
                <field name="partner_id" />
                <field name="amount_requested" />
                <field name="amount_approved" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="nuhw_hardship_request_action" model="ir.actions.act_window">
        <field name="name">Hardship Fund Requests</field>
        <field name="res_model">nuhw.hardship_request</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
