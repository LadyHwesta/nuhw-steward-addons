<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="nuhw_direct_action_view_form" model="ir.ui.view">
        <field name="name">nuhw.direct_action.form</field>
        <field name="model">nuhw.direct_action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,completed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Action name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="action_type" />
                            <field name="date" />
                            <field name="organizer_id" />
                        </group>
                        <group>
                            <field name="unit_ids" widget="many2many_tags" />
                            <field name="participant_ids" widget="many2many_tags" />
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes / outcome..." />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="nuhw_direct_action_view_list" model="ir.ui.view">
        <field name="name">nuhw.direct_action.list</field>
        <field name="model">nuhw.direct_action</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="name" />
                <field name="action_type" />
                <field name="unit_ids" widget="many2many_tags" />
                <field name="state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="nuhw_direct_action_action" model="ir.actions.act_window">
        <field name="name">Direct Actions</field>
        <field name="res_model">nuhw.direct_action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
